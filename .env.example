# =====================================================================
# Tempo Assist - Service Desk
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env (ja esta no .gitignore).
# =====================================================================

# ---------- Aplicacao ----------
PORT=3000

# development | production
# Em "production" o sistema fica mais rigoroso: exige HTTPS nos cookies,
# recusa senhas em texto puro e nao expoe detalhes de erro ao usuario.
NODE_ENV=development

# Token para o endpoint de sincronizacao de e-mail (/api/sync/emails).
# E um token de maquina (usado por cron externo), nao de usuario.
INTERNAL_API_TOKEN=troque-isto-por-um-token-forte

# Deixe "true" quando rodar atras de proxy/HTTPS (Render, Nginx).
# Sem isso, os cookies "secure" nunca sao enviados e o login nao funciona.
TRUST_PROXY=true

# Origens externas autorizadas a chamar a API (separadas por virgula).
# Deixe VAZIO se o frontend e a API estao no mesmo servidor (caso padrao).
CORS_ORIGINS=

# ---------- Banco de dados (Postgres) ----------
# Producao: crie um projeto gratuito em supabase.com, va em
# Project Settings > Database > Connection string (modo "URI") e cole aqui.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Provedores gerenciados (Supabase, Neon, Render) exigem SSL: deixe "true".
# Use "false" apenas para um Postgres local sem SSL.
DATABASE_SSL=true

# Planos gratuitos costumam limitar conexoes simultaneas.
DB_POOL_MAX=10

# ---------- Sessao ----------
# Gere uma string aleatoria longa. Exemplo para gerar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Por quantas horas a sessao permanece valida.
SESSION_HOURS=8

# ---------- Autenticacao ----------
# local = usuarios definidos abaixo, neste arquivo (desenvolvimento/testes)
# ldap  = Active Directory da empresa (producao interna)
#         Nesse caso use o .env.ad.example como base e valide com:
#         npm run test-ldap -- usuario senha
AUTH_PROVIDER=local

# ---------- Usuarios (usados quando AUTH_PROVIDER=local) ----------
# IMPORTANTE: em producao as senhas DEVEM ser hashes bcrypt.
# Gere cada hash com:  npm run hash-password -- "suaSenha"
# Em desenvolvimento, senha em texto puro funciona (com aviso no console).

# Conta administradora: acesso total (chamados + inventario).
MASTER_USERNAME=admin
MASTER_PASSWORD=troque-esta-senha

# Contas adicionais no formato  usuario:senhaOuHash:acessoInventario
# separadas por virgula. O terceiro campo (true/false) libera o Inventario.
# Exemplo: joao abre chamados mas NAO acessa o inventario; maria acessa tudo.
EXTRA_USERS=joao:1234:false,maria:5678:true

# ---------- Aprovacao de chamados (de acordo do gestor) ----------
# Mapeia cada setor ao usuario que aprova os chamados daquele setor.
# O usuario PRECISA existir em MASTER_USERNAME ou EXTRA_USERS, senao os
# chamados ficam pendentes sem ninguem para aprovar (o sistema avisa na subida).
# Formato: Setor:usuarioAprovador, separados por virgula.
DEPARTMENT_APPROVERS=Financeiro:maria,TI:joao

# ---------- Papeis de aprovacao (tabela de "de acordo" obrigatorio) ----------
# O sistema detecta automaticamente assuntos que exigem de acordo
# (criacao de usuario, acesso SAP, liberacao de USB, etc) com base no
# catalogo em src/config/approvalRules.js.
#
# Aqui voce diz QUEM exerce cada papel citado naquele catalogo.
# Papeis separados por virgula; varios usuarios no mesmo papel usam "|".
# Os papeis usados hoje sao: Gestor, Gestao TI, Superior, Diretor TI,
# Gestor/Responsavel.
APPROVAL_ROLES=Gestor:maria|joao,Diretor TI:admin,Superior:maria,Gestão TI:joao,Gestor/Responsável:maria

# ---------- Jira Service Management ----------
JIRA_BASE_URL=https://SEUDOMINIO.atlassian.net
JIRA_EMAIL=integracao@tempoassist.com.br
JIRA_API_TOKEN=
# Descubra os IDs com (troque email/token/dominio):
#   curl -u EMAIL:TOKEN https://SEUDOMINIO.atlassian.net/rest/servicedeskapi/servicedesk
#   curl -u EMAIL:TOKEN https://SEUDOMINIO.atlassian.net/rest/servicedeskapi/servicedesk/{id}/requesttype
JIRA_SERVICE_DESK_ID=
JIRA_REQUEST_TYPE_ID=

# ---------- Automacao de e-mail (opcional) ----------
# Deixe "false" para usar apenas o formulario "Abrir Chamado" do sistema.
# Mude para "true" somente depois de configurar e testar a leitura de e-mail.
ENABLE_EMAIL_SYNC=false
SYNC_INTERVAL_MINUTES=5

# Quantos e-mails processar por ciclo (protege contra caixas com milhares
# de mensagens nao lidas).
MAX_EMAILS_PER_SYNC=25

# graph = Microsoft Graph / Outlook (producao; exige registro de app no Azure AD)
# imap  = IMAP generico (ex: Gmail com senha de app), util para testes
EMAIL_PROVIDER=graph

# --- Microsoft Graph (quando EMAIL_PROVIDER=graph) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=servicedesk@tempoassist.com.br

# --- IMAP / Gmail (quando EMAIL_PROVIDER=imap) ---
# Gere uma "senha de app" em myaccount.google.com/apppasswords
# (requer verificacao em 2 etapas ativa na conta Google).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seuemail@gmail.com
IMAP_PASSWORD=

# ---------- Smoke test (opcional) ----------
# Usuario SEM acesso ao inventario, para validar o bloqueio de permissoes.
SMOKE_LIMITED_USER=joao
SMOKE_LIMITED_PASS=1234

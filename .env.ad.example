# =====================================================================
# Tempo Assist - Service Desk
# MODELO 2: autenticacao pelo ACTIVE DIRECTORY da empresa
#
# Use este modelo quando o sistema estiver hospedado DENTRO da rede
# corporativa, com acesso de rede ao controlador de dominio.
# Para desenvolvimento/testes, use o .env.example (modo local).
#
# Copie para .env e preencha os valores.
# =====================================================================

# ---------- Aplicacao ----------
PORT=3000
NODE_ENV=production
INTERNAL_API_TOKEN=troque-isto-por-um-token-forte

# Deixe "true" se houver proxy reverso (IIS, Nginx) na frente.
TRUST_PROXY=true
CORS_ORIGINS=

# ---------- Banco de dados (Postgres) ----------
DATABASE_URL=postgresql://usuario:senha@servidor:5432/tempoassist
DATABASE_SSL=false
DB_POOL_MAX=10

# ---------- Sessao ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
SESSION_HOURS=8

# =====================================================================
# AUTENTICACAO: ACTIVE DIRECTORY
# =====================================================================
AUTH_PROVIDER=ldap

# Endereco do controlador de dominio.
# ldap://  = sem criptografia (porta 389)   - apenas em rede interna confiavel
# ldaps:// = com TLS (porta 636)            - recomendado
LDAP_URL=ldap://dc01.tempoassist.local:389

# Certificado interno costuma nao ser reconhecido; deixe "false" nesse caso.
# So use "true" se o certificado do DC for emitido por uma CA confiavel.
LDAP_TLS_REJECT_UNAUTHORIZED=false

# Onde os usuarios ficam no diretorio.
LDAP_BASE_DN=OU=Usuarios,DC=tempoassist,DC=local

# Conta de servico (somente leitura) usada para localizar o usuario
# antes de validar a senha. NAO precisa ser administrador.
LDAP_BIND_DN=CN=svc-servicedesk,OU=Usuarios,DC=tempoassist,DC=local
LDAP_BIND_PASSWORD=

# Campo que a pessoa digita no login.
# Active Directory: sAMAccountName (ex: yan.coloda)
# OpenLDAP:         uid
LDAP_LOGIN_ATTRIBUTE=sAMAccountName

# Onde procurar os grupos. Preencha apenas se os grupos ficarem fora
# do LDAP_BASE_DN. No AD normalmente nao e necessario, porque o proprio
# usuario ja traz o atributo memberOf.
LDAP_GROUP_BASE_DN=OU=Grupos,DC=tempoassist,DC=local

# ---------- Permissoes por grupo do AD ----------
# Quem pertence a este grupo acessa o modulo de Inventario.
LDAP_GROUP_INVENTORY=SD-Inventario

# Mapeia os papeis de aprovacao aos grupos do AD.
# Formato: Papel:GrupoAD, separados por virgula.
# Os papeis precisam bater com os usados em src/config/approvalRules.js:
# Gestor, Gestao TI, Superior, Diretor TI, Gestor/Responsavel.
LDAP_GROUP_ROLES=Gestor:SD-Gestores,Gestão TI:SD-GestaoTI,Superior:SD-Superiores,Diretor TI:SD-DiretorTI,Gestor/Responsável:SD-Gestores

# ---------- Aprovacao por setor ----------
# Continua valendo: define quem aprova os chamados de cada setor.
# Use os logins do AD (sAMAccountName).
DEPARTMENT_APPROVERS=Financeiro:maria.silva,TI:yan.coloda

# ---------- Jira Service Management ----------
JIRA_BASE_URL=https://SEUDOMINIO.atlassian.net
JIRA_EMAIL=integracao@tempoassist.com.br
JIRA_API_TOKEN=
JIRA_SERVICE_DESK_ID=
JIRA_REQUEST_TYPE_ID=

# ---------- Automacao de e-mail (opcional) ----------
ENABLE_EMAIL_SYNC=false
SYNC_INTERVAL_MINUTES=5
MAX_EMAILS_PER_SYNC=25
EMAIL_PROVIDER=graph

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=servicedesk@tempoassist.com.br
